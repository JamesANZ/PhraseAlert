HUGGINGFACE_API_KEY=hf_...
AUTH_SECRET=generate-with-openssl-rand-base64-32
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Optional: direct (non-pooled) URL for migrations
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require
# AUTH_URL=http://localhost:3000
# Public site URL used in emails and billing redirects (never leave as localhost in prod)
NEXT_PUBLIC_APP_URL=https://phrasealert.com

# Live web retrieval (Tavily Search + Extract)
TAVILY_API_KEY=tvly-...

# Google OAuth (required for sign-in)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Billing: Stripe (card subscription + prepaid)
STRIPE_SECRET_KEY=
STRIPE_PUBLISH_KEY=
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PLUS_MONTHLY=price_...
STRIPE_PRICE_ID_MAX_MONTHLY=price_...
# Optional: dedicated prepaid prices; otherwise Checkout uses inline price_data
# STRIPE_PRICE_ID_PLUS_PREPAID=price_...
# STRIPE_PRICE_ID_MAX_PREPAID=price_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Billing: Helio / MoonPay Commerce (crypto prepaid)
HELIO_API_KEY=...
HELIO_SECRET_KEY=...
HELIO_PAYLINK_ID=...
# Optional Max paylink (falls back to HELIO_PAYLINK_ID with Max amount)
# HELIO_PAYLINK_ID_MAX=...
HELIO_WEBHOOK_SECRET=...
# HELIO_API_BASE=https://api.hel.io/v1

# SMS alerts (Plus / Max) via Twilio
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

# Expiry / downgrade emails + watch trigger alerts
RESEND_API_KEY=re_...
EMAIL_FROM="PhraseAlert <alerts@phrasealert.com>"

# CRON_SECRET=your-secret-for-scheduled-checks
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
